# Copiar este archivo como `.env` y completar con los valores reales.
# `.env` está en .gitignore: nunca se commitea, porque contiene credenciales.

# Connection string de Supabase.
# Se obtiene en: Supabase > tu proyecto > Connect > ORMs / SQLAlchemy
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/postgres

# User-Agent identificable que se envía al scrapear. Formato híbrido tipo
# Googlebot: pasa los filtros básicos de los WAF (necesita "verse" como un
# navegador) sin dejar de ser honesto — no es un Chrome real copiado, sigue
# identificando el proyecto para quien mire los logs. Sin mail de contacto
# a propósito, para no exponer datos personales en logs de terceros.
USER_AGENT=Mozilla/5.0 (compatible; relevamiento-personal/0.1)
